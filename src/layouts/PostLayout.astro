---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import { formatDate, getReadingTime } from '../utils/theme.js';

const { title, description, pubDate, updatedDate, tags = [], content } = Astro.props;
const publishedAt = new Date(pubDate).toISOString();
const updatedAt = updatedDate ? new Date(updatedDate).toISOString() : undefined;
---

<BaseLayout title={title} description={description}>
  <article class="post-article">
    <div class="container">
      <header class="post-header">
        <div class="post-kicker">
          <time datetime={publishedAt}>{formatDate(pubDate)}</time>
          {updatedDate && <time datetime={updatedAt}>更新于 {formatDate(updatedDate)}</time>}
          <span>{getReadingTime(content)}</span>
        </div>

        <h1>{title}</h1>
        {description && <p class="post-description">{description}</p>}

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(tag => (
              <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>
            ))}
          </div>
        )}
      </header>

      <div class="reading-progress" aria-hidden="true">
        <div class="progress-bar"></div>
      </div>

      <div class="post-body">
        <TableOfContents />
        <div class="post-content">
          <div class="prose">
            <slot />
          </div>
        </div>
      </div>

      <footer class="post-footer">
        <a href="/archive" class="back-link">回到文章目录</a>
        <button class="copy-link" id="copy-link" type="button">复制链接</button>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-article {
    padding: var(--space-16) 0 0;
  }

  .post-header {
    max-width: var(--reader-max-width);
    margin: 0 auto var(--space-12);
    padding: 0 var(--container-padding) var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .post-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-sm);
  }

  .post-header h1 {
    margin-bottom: var(--space-5);
    color: var(--color-primary);
    font-size: clamp(2.25rem, 7vw, 4.4rem);
    line-height: 1.12;
  }

  .post-description {
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-xl);
    line-height: 1.7;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .post-tags a {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-xs);
    line-height: 1;
  }

  .post-tags a:hover {
    color: var(--color-paper);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    width: 100%;
    height: 2px;
    background: transparent;
  }

  .progress-bar {
    width: 0%;
    height: 100%;
    background: var(--color-accent);
    transition: width 120ms ease-out;
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: var(--space-10);
    align-items: start;
  }

  .post-content {
    justify-self: end;
    width: min(100%, var(--reader-max-width));
  }

  .prose {
    color: var(--color-text-primary);
    font-size: var(--text-lg);
    line-height: 1.95;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    scroll-margin-top: 6rem;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }

  .prose :global(h2) {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-2xl);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-6);
  }

  .prose :global(li) {
    margin: var(--space-2) 0;
  }

  .prose :global(a) {
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .prose :global(blockquote) {
    margin: var(--space-8) 0;
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    border-left: 3px solid var(--color-accent);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .prose :global(code) {
    padding: 0.08rem 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    color: var(--color-accent);
    background: var(--color-surface);
    font-family: var(--font-family-mono);
    font-size: 0.88em;
  }

  .prose :global(pre),
  .prose :global(.astro-code) {
    margin: var(--space-8) 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    background: var(--color-surface) !important;
    box-shadow: 0 10px 28px var(--color-shadow);
    overflow-x: auto;
    line-height: 1.7;
  }

  .prose :global(pre code),
  .prose :global(.astro-code code) {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    color: inherit;
    white-space: pre;
  }

  .prose :global(img) {
    display: block;
    width: auto;
    max-width: min(100%, 820px);
    max-height: 68vh;
    margin: var(--space-10) auto;
    border-radius: var(--border-radius-lg);
    box-shadow: 0 18px 42px var(--color-shadow);
    object-fit: contain;
    cursor: zoom-in;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--reader-max-width);
    margin: var(--space-16) auto 0;
    padding: var(--space-8) var(--container-padding) 0;
    border-top: 1px solid var(--color-border);
  }

  .back-link,
  .copy-link {
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-sm);
  }

  .copy-link {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .copy-link:hover {
    color: var(--color-paper);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .image-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: var(--space-6);
    background: rgba(0, 0, 0, 0.88);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal), visibility var(--transition-normal);
    cursor: zoom-out;
  }

  .image-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .image-overlay img {
    max-width: 94vw;
    max-height: 92vh;
    border-radius: var(--border-radius);
    object-fit: contain;
  }

  .close-btn {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    color: white;
    background: rgba(255, 255, 255, 0.12);
    cursor: pointer;
  }

  @media (max-width: 1040px) {
    .post-body {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .post-content {
      justify-self: center;
      padding: 0 var(--container-padding);
    }
  }

  @media (max-width: 640px) {
    .post-article {
      padding-top: var(--space-12);
    }

    .post-header {
      margin-bottom: var(--space-8);
    }

    .prose {
      font-size: var(--text-base);
      line-height: 1.85;
    }

    .post-footer {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>

<script>
  function updateReadingProgress() {
    const article = document.querySelector('.post-content');
    const progressBar = document.querySelector('.progress-bar');
    if (!article || !progressBar) return;

    const articleTop = article.getBoundingClientRect().top + window.scrollY;
    const articleHeight = article.scrollHeight;
    const scrollTop = window.scrollY;
    const viewportHeight = window.innerHeight;
    const progress = ((scrollTop - articleTop + viewportHeight * 0.35) / Math.max(articleHeight, 1)) * 100;

    progressBar.style.width = `${Math.max(0, Math.min(100, progress))}%`;
  }

  function setupCopyLink() {
    const button = document.getElementById('copy-link');
    if (!button) return;

    button.addEventListener('click', async () => {
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(window.location.href);
        button.textContent = '已复制';
      } catch (_) {
        button.textContent = '复制失败';
      }

      window.setTimeout(() => {
        button.textContent = original;
      }, 1800);
    });
  }

  function setupImageZoom() {
    const images = document.querySelectorAll('.prose img');
    if (!images.length) return;

    const overlay = document.createElement('div');
    overlay.className = 'image-overlay';
    overlay.innerHTML = '<button class="close-btn" aria-label="关闭">×</button><img src="" alt="" />';
    document.body.appendChild(overlay);

    const overlayImg = overlay.querySelector('img');
    const closeButton = overlay.querySelector('.close-btn');

    function closeOverlay() {
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    images.forEach((img) => {
      img.addEventListener('click', () => {
        overlayImg.src = img.src;
        overlayImg.alt = img.alt || '';
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) closeOverlay();
    });
    closeButton.addEventListener('click', closeOverlay);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && overlay.classList.contains('active')) closeOverlay();
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateReadingProgress();
    setupCopyLink();
    setupImageZoom();
  });

  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  window.addEventListener('resize', updateReadingProgress);
</script>
