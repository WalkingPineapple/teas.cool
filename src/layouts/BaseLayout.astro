---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/globals.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title: customTitle,
  description = SITE_DESCRIPTION,
  image = '/preview.png'
} = Astro.props;

const title = customTitle ? `${customTitle} - ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = savedTheme || (prefersDark ? 'dark' : 'light');
        } catch (_) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={title} href={new URL('rss.xml', Astro.site)} />
    <link rel="preconnect" href="https://cdn.bootcdn.net" crossorigin />
    <link rel="preconnect" href="https://npm.elemecdn.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.bootcdn.net/ajax/libs/lxgw-wenkai-screen-webfont/1.7.0/style.min.css"
      crossorigin
      onerror="this.onerror=null;this.href='https://npm.elemecdn.com/lxgw-wenkai-screen-webfont@1.7.0/style.css';"
    />
    <link
      rel="stylesheet"
      href="https://cdn.bootcdn.net/ajax/libs/inter-ui/4.1.1/inter-variable-latin.min.css"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>
  <body>
    <Header />
    <main class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .main-content {
    min-height: calc(100vh - 220px);
    padding: 0 0 var(--space-16);
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      view-transition-name: root;
    }
  }
</style>
