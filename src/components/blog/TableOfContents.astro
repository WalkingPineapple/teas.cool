---
---

<aside class="table-of-contents" id="toc" aria-label="文章目录">
  <div class="toc-header">
    <h2>目录</h2>
    <button class="toc-toggle" id="toc-toggle" type="button" aria-label="收起或展开目录">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6,9 12,15 18,9"></polyline>
      </svg>
    </button>
  </div>
  <nav class="toc-nav" id="toc-nav">
    <ol class="toc-list" id="toc-list"></ol>
  </nav>
</aside>

<style>
  .table-of-contents {
    position: sticky;
    top: 6rem;
    order: 2;
    max-height: calc(100vh - 8rem);
    overflow: auto;
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-border);
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .toc-header h2 {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-sm);
  }

  .toc-toggle {
    display: none;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: transparent;
    cursor: pointer;
  }

  .toc-toggle svg {
    transition: transform var(--transition-fast);
  }

  .toc-toggle.expanded svg {
    transform: rotate(180deg);
  }

  .toc-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-link {
    display: block;
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-decoration: none;
  }

  .toc-link:hover,
  .toc-link.active {
    color: var(--color-primary);
  }

  .toc-item.level-3 {
    padding-left: var(--space-3);
  }

  .toc-item.level-4 {
    padding-left: var(--space-6);
  }

  .toc-item.level-4 .toc-link {
    font-size: var(--text-xs);
  }

  @media (max-width: 1040px) {
    .table-of-contents {
      position: static;
      order: 0;
      width: min(100%, var(--reader-max-width));
      margin: 0 auto;
      padding: var(--space-4) var(--container-padding);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      border-left: 0;
    }

    .toc-toggle {
      display: inline-grid;
      place-items: center;
    }

    .toc-nav {
      display: none;
      padding-top: var(--space-3);
    }

    .toc-nav.expanded {
      display: block;
    }
  }
</style>

<script>
  class TableOfContents {
    constructor() {
      this.toc = document.getElementById('toc');
      this.tocList = document.getElementById('toc-list');
      this.tocNav = document.getElementById('toc-nav');
      this.tocToggle = document.getElementById('toc-toggle');
      this.headings = [];
      this.activeId = '';
      this.ticking = false;
      this.init();
    }

    init() {
      if (!this.toc || !this.tocList) return;
      this.generate();

      if (!this.headings.length) {
        this.toc.hidden = true;
        return;
      }

      this.bind();
      this.updateActiveHeading();
    }

    generate() {
      const headings = document.querySelectorAll('.prose h2, .prose h3, .prose h4');

      headings.forEach((heading, index) => {
        const level = Number(heading.tagName.slice(1));
        const text = heading.textContent.trim();
        const id = heading.id || this.createId(text, index);

        heading.id = id;
        this.headings.push({ element: heading, id });

        const item = document.createElement('li');
        item.className = `toc-item level-${level}`;

        const link = document.createElement('a');
        link.href = `#${id}`;
        link.className = 'toc-link';
        link.textContent = text;
        link.addEventListener('click', (event) => {
          event.preventDefault();
          document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          this.setActiveHeading(id);
        });

        item.appendChild(link);
        this.tocList.appendChild(item);
      });
    }

    createId(text, index) {
      const id = text
        .toLowerCase()
        .replace(/[^\w\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/--+/g, '-')
        .trim();

      return id || `heading-${index}`;
    }

    bind() {
      this.tocToggle?.addEventListener('click', () => {
        this.tocNav.classList.toggle('expanded');
        this.tocToggle.classList.toggle('expanded');
      });

      window.addEventListener('scroll', () => this.requestUpdate(), { passive: true });
      window.addEventListener('resize', () => this.requestUpdate());
    }

    requestUpdate() {
      if (this.ticking) return;
      this.ticking = true;
      window.requestAnimationFrame(() => {
        this.updateActiveHeading();
        this.ticking = false;
      });
    }

    updateActiveHeading() {
      const scrollPosition = window.scrollY + 120;
      let current = '';

      for (let i = this.headings.length - 1; i >= 0; i -= 1) {
        if (this.headings[i].element.offsetTop <= scrollPosition) {
          current = this.headings[i].id;
          break;
        }
      }

      if (current !== this.activeId) this.setActiveHeading(current);
    }

    setActiveHeading(id) {
      this.tocList.querySelectorAll('.toc-link.active').forEach(link => link.classList.remove('active'));
      if (id) this.tocList.querySelector(`a[href="#${CSS.escape(id)}"]`)?.classList.add('active');
      this.activeId = id;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new TableOfContents();
  });
</script>
