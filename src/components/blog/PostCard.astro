---
import { formatDate, getReadingTime } from '../../utils/theme.js';

interface Props {
  title: string;
  href: string;
  description: string;
  date: string;
  tags?: string[];
  content?: string;
}

const { title, href, description, date, tags = [], content } = Astro.props;
---

<article class="post-card">
  <a href={href} class="post-main">
    <div class="post-date">
      <time datetime={date}>{formatDate(date)}</time>
      {content && <span>{getReadingTime(content)}</span>}
    </div>

    <div class="post-copy">
      <h3 class="post-title">{title}</h3>
      {description && <p class="post-description">{description}</p>}
    </div>
  </a>

  {tags.length > 0 && (
    <div class="post-tags" aria-label="文章标签">
      {tags.map(tag => (
        <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">
          {tag}
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .post-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }

  .post-card:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .post-main {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--space-6);
    color: inherit;
    text-decoration: none;
  }

  .post-main:hover .post-title {
    color: var(--color-primary);
  }

  .post-date {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: 0.25rem;
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-sm);
    line-height: 1.4;
    white-space: nowrap;
  }

  .post-date span {
    font-size: var(--text-xs);
  }

  .post-title {
    margin: 0 0 var(--space-2);
    color: var(--color-text-primary);
    font-size: var(--text-xl);
    line-height: 1.35;
    transition: color var(--transition-fast);
  }

  .post-description {
    max-width: 44rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .post-tags {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: 0.2rem;
    max-width: 14rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-xs);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .tag:hover {
    color: var(--color-paper);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media (max-width: 760px) {
    .post-card {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .post-main {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .post-date {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .post-tags {
      justify-content: flex-start;
      max-width: none;
      padding-top: 0;
    }
  }
</style>
