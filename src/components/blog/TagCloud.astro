---
interface Props {
  tags: string[];
  selectedTag?: string;
}

const { tags, selectedTag } = Astro.props;

const tagCounts = tags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {});

const sortedTags = Object.entries(tagCounts)
  .sort(([, a], [, b]) => b - a)
  .map(([tag, count]) => ({ tag, count }));
---

<div class="tag-cloud">
  <h3>标签</h3>
  <div class="tags-list">
    <a href="/archive" class:list={['tag-item', { active: !selectedTag }]}>
      全部
    </a>
    {sortedTags.map(({ tag, count }) => (
      <a
        href={`/tags/${encodeURIComponent(tag)}`}
        class:list={['tag-item', { active: selectedTag === tag }]}
      >
        <span>{tag}</span>
        <small>{count}</small>
      </a>
    ))}
  </div>
</div>

<style>
  .tag-cloud h3 {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-sm);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    font-family: var(--font-family-ui);
    font-size: var(--text-sm);
    line-height: 1;
    text-decoration: none;
  }

  .tag-item small {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .tag-item:hover,
  .tag-item.active {
    color: var(--color-paper);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .tag-item:hover small,
  .tag-item.active small {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }
</style>
