---
import { noteUrl } from '../lib/content';
const { notes } = Astro.props;
// The spiral grows with the notes: always the next Fibonacci size with room to spare.
const SIZES = [21, 34, 55, 89, 144, 233, 377, 610, 987];
const count = SIZES.find((size) => size >= notes.length * 1.5) ?? notes.length;
const step = 44 / Math.sqrt(count);
const groups = { writing: 'writing', reflection: 'writing', story: 'story', reading: 'reading', travel: 'travel' };
const eyes = Array.from({ length: count }, (_, i) => {
  const n = i + 1;
  const radius = step * Math.sqrt(n);
  const angle = n * 2.39996;
  const size = step * (0.62 + 0.5 * Math.sqrt(n / count));
  const left = (50 + radius * Math.cos(angle)).toFixed(2);
  const top = (50 + radius * Math.sin(angle)).toFixed(2);
  return { style: `left:${left}%;top:${top}%;width:${size.toFixed(2)}%`, note: notes[i] };
});
---
<div class="spiral" data-spiral>
  {eyes.map((e) => e.note
    ? <a class={`eye ${groups[e.note.data.type]}`} href={noteUrl(e.note)} aria-label={e.note.data.title} data-title={e.note.data.title} style={e.style}></a>
    : <span class="eye empty" aria-hidden="true" style={e.style}></span>)}
</div>
<script>
  const out = document.getElementById('spiral-read');
  // Touch screens can't hover, so say what a tap does instead.
  if (out && matchMedia('(hover: none)').matches) out.textContent = '点一只眼睛，打开那篇笔记。';
  document.querySelectorAll('[data-spiral] a').forEach((a) => {
    const show = () => { if (out) out.textContent = a.getAttribute('data-title'); };
    a.addEventListener('mouseenter', show);
    a.addEventListener('focus', show);
  });
</script>
