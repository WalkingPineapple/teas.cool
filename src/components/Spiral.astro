---
import { noteUrl } from '../lib/content';
const { notes } = Astro.props;
const COUNT = 144;
const groups = { writing: 'writing', reflection: 'writing', reading: 'reading', travel: 'travel' };
const eyes = Array.from({ length: Math.max(COUNT, notes.length) }, (_, i) => {
  const n = i + 1;
  const radius = (46 * Math.sqrt(n)) / Math.sqrt(Math.max(COUNT, notes.length));
  const angle = n * 2.39996;
  return {
    left: `${(50 + radius * Math.cos(angle)).toFixed(2)}%`,
    top: `${(50 + radius * Math.sin(angle)).toFixed(2)}%`,
    size: `${(10 + Math.sqrt(n) * 1.1).toFixed(1)}px`,
    note: notes[i],
  };
});
---
<div class="spiral" data-spiral>
  {eyes.map((e) => e.note
    ? <a class={`eye ${groups[e.note.data.type]}`} href={noteUrl(e.note)} aria-label={e.note.data.title} data-title={e.note.data.title} style={`left:${e.left};top:${e.top};width:${e.size};height:${e.size}`}></a>
    : <span class="eye empty" aria-hidden="true" style={`left:${e.left};top:${e.top};width:${e.size};height:${e.size}`}></span>)}
</div>
<script>
  document.querySelectorAll('[data-spiral] a').forEach((a) => {
    const show = () => {
      const out = document.getElementById('spiral-read');
      if (out) out.textContent = a.getAttribute('data-title');
    };
    a.addEventListener('mouseenter', show);
    a.addEventListener('focus', show);
  });
</script>
