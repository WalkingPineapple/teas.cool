---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import Button from "../components/ui/Button.astro";

const allPosts = await Astro.glob("../pages/posts/*.md");
allPosts.sort((a, b) => Date.parse(b.frontmatter.pubDate) - Date.parse(a.frontmatter.pubDate));

const recentPosts = allPosts.slice(0, 7);
const latestPost = recentPosts[0];
---

<BaseLayout>
  <section class="home-hero">
    <div class="container-narrow">
      <h1>直接开摆</h1>
      <p class="hero-subtitle">闲来拈花随风笑，煮茶不问世间嚣。</p>
      <p class="hero-text">
        To be a sailor of the world, bound for all ports.
      </p>
      {latestPost && (
        <a class="latest-note" href={latestPost.url}>
          <span>最近一篇</span>
          <strong>{latestPost.frontmatter.title}</strong>
        </a>
      )}
    </div>
  </section>

  <section class="home-feed">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Notes</span>
          <h2>最近写下的</h2>
        </div>
        <a href="/archive" class="muted-link">全部文章</a>
      </div>

      <div class="post-list">
        {recentPosts.map((post) => (
          <PostCard
            title={post.frontmatter.title}
            href={post.url}
            description={post.frontmatter.description || post.compiledContent().replace(/<[^>]*>/g, '').slice(0, 120) + '...'}
            date={post.frontmatter.pubDate}
            tags={post.frontmatter.tags || []}
            content={post.compiledContent()}
          />
        ))}
      </div>

      <div class="feed-action">
        <Button href="/archive" variant="secondary">翻完整个目录</Button>
      </div>
    </div>
  </section>

  <section class="home-about surface-band">
    <div class="container-narrow">
      <span class="eyebrow">About</span>
      <h2>闲敲棋子落灯花。</h2>
      <p>最是人间留不住，朱颜辞镜花辞树。</p>
      <Button href="/about" variant="primary">再多看一点</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding: clamp(4rem, 11vw, 8rem) 0 var(--section-spacing);
  }

  .home-hero h1 {
    margin-bottom: var(--space-4);
    font-size: clamp(3rem, 10vw, 5.75rem);
    line-height: 1.05;
    color: var(--color-primary);
  }

  .hero-subtitle {
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
    font-size: var(--text-2xl);
    line-height: 1.5;
  }

  .hero-text {
    max-width: 38rem;
    margin-bottom: var(--space-8);
    font-size: var(--text-lg);
  }

  .latest-note {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .latest-note span {
    color: var(--color-text-muted);
    font-family: var(--font-family-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .latest-note strong {
    color: var(--color-text-primary);
    font-size: var(--text-xl);
    transition: color var(--transition-fast);
  }

  .latest-note:hover strong {
    color: var(--color-primary);
  }

  .home-feed {
    padding: 0 0 var(--section-spacing);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .section-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-3xl);
  }

  .feed-action {
    margin-top: var(--space-8);
    text-align: center;
  }

  .home-about {
    padding: var(--section-spacing) 0;
  }

  .home-about h2 {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
  }

  .home-about p {
    margin-bottom: var(--space-8);
    font-size: var(--text-lg);
  }

  @media (max-width: 640px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
