---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="字体预览">
  <div class="font-preview">
    <div class="container">
      <header class="preview-header">
        <h1>字体预览</h1>
        <p>测试不同字体在博客中的显示效果</p>
      </header>

      <!-- 霞鹜文楷屏幕版 -->
      <section class="font-section">
        <h2 class="font-title">霞鹜文楷屏幕版（LXGW WenKai Screen）- 当前正文</h2>
        <div class="font-sample lxgw-wenkai">
          <h3>标题展示</h3>
          <p class="large-text">闲来拈花随风笑，煮茶不问世间嚣</p>
          <p>这是一段正文内容。霞鹜文楷屏幕版通过大陆访问更友好的 CDN 加载，具有温润的笔触和比较轻松的阅读气质。Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          <p>中英文混排测试：Technology 技术、Design 设计、Development 开发。数字测试：1234567890</p>
          <code class="code-sample">console.log('Hello World!');</code>
        </div>
      </section>

      <!-- 系统字体兜底 -->
      <section class="font-section">
        <h2 class="font-title">系统中文字体 - 加载失败时兜底</h2>
        <div class="font-sample system-serif">
          <h3>标题展示</h3>
          <p class="large-text">闲来拈花随风笑，煮茶不问世间嚣</p>
          <p>这是一段正文内容。如果外部字体还没加载完成，浏览器会先使用本机字体显示，页面不会白屏等待。Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          <p>中英文混排测试：Technology 技术、Design 设计、Development 开发。数字测试：1234567890</p>
          <code class="code-sample">console.log('Hello World!');</code>
        </div>
      </section>

      <!-- Inter字体 -->
      <section class="font-section">
        <h2 class="font-title">Inter Variable - 英文/UI 字体</h2>
        <div class="font-sample inter-font">
          <h3>标题展示</h3>
          <p class="large-text">闲来拈花随风笑，煮茶不问世间嚣</p>
          <p>这是一段正文内容。Inter 只负责英文和 UI 场景，小尺寸导航、按钮、标签会更清晰。Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          <p>中英文混排测试：Technology 技术、Design 设计、Development 开发。数字测试：1234567890</p>
          <code class="code-sample">console.log('Hello World!');</code>
        </div>
      </section>

      <!-- 字体特性对比 -->
      <section class="comparison-section">
        <h2>字体特性对比</h2>
        <div class="comparison-grid">
          <div class="comparison-item">
            <h4>霞鹜文楷屏幕版</h4>
            <ul>
              <li>正文主字体</li>
              <li>温润亲和</li>
              <li>中文优化</li>
              <li>通过 BootCDN 加载</li>
              <li>文件比英文字体大</li>
            </ul>
          </div>
          <div class="comparison-item">
            <h4>系统字体</h4>
            <ul>
              <li>无需网络请求</li>
              <li>速度最快</li>
              <li>各系统观感不同</li>
              <li>作为字体加载兜底</li>
              <li>保证页面立即可读</li>
            </ul>
          </div>
          <div class="comparison-item">
            <h4>Inter</h4>
            <ul>
              <li>UI 专用</li>
              <li>现代简洁</li>
              <li>英文优秀</li>
              <li>小尺寸清晰</li>
              <li>不负责中文正文</li>
            </ul>
          </div>
        </div>
      </section>

      <div class="recommendation">
        <h3>推荐设置</h3>
        <p>正文使用 <strong>霞鹜文楷屏幕版</strong>，UI 使用 Inter Variable，加载失败时回退到系统中文字体。</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .font-preview {
    padding: var(--space-8) 0;
  }

  .preview-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .preview-header h1 {
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .font-section {
    margin-bottom: var(--space-12);
    background-color: var(--color-surface);
    padding: var(--space-8);
    border-radius: var(--border-radius-lg);
  }

  .font-title {
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-border);
  }

  .font-sample {
    line-height: 1.7;
  }

  .large-text {
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: var(--space-6);
  }

  .code-sample {
    display: block;
    background-color: var(--color-bg);
    padding: var(--space-3);
    border-radius: var(--border-radius);
    margin-top: var(--space-4);
    font-family: var(--font-family-mono);
    font-size: var(--text-sm);
  }

  /* 字体样式 */
  .lxgw-wenkai {
    font-family: "LXGW WenKai Screen", "LXGW WenKai", serif;
  }

  .system-serif {
    font-family: "KaiTi", "楷体", "STKaiti", "华文楷体", serif;
  }

  .inter-font {
    font-family: "InterVariable", "Inter", sans-serif;
  }

  /* 对比区域 */
  .comparison-section {
    background-color: var(--color-surface);
    padding: var(--space-8);
    border-radius: var(--border-radius-lg);
    margin-bottom: var(--space-8);
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .comparison-item {
    background-color: var(--color-bg);
    padding: var(--space-6);
    border-radius: var(--border-radius);
  }

  .comparison-item h4 {
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .comparison-item ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .comparison-item li {
    padding: var(--space-1) 0;
    font-size: var(--text-sm);
  }

  /* 推荐区域 */
  .recommendation {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: white;
    padding: var(--space-8);
    border-radius: var(--border-radius-lg);
    text-align: center;
  }

  .recommendation h3 {
    color: white;
    margin-bottom: var(--space-4);
  }

  .recommendation p {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-lg);
    margin: 0;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .font-section, .comparison-section, .recommendation {
      padding: var(--space-6);
    }

    .comparison-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
