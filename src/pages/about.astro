---
import Base from '../layouts/Base.astro';
const work = [1, 2, 3, 4];
---
<Base title="关于">
  <main class="wrap">
    <div class="page-head"><h1>你好，我是 <em>Pineapple。</em></h1><p class="lede">[在这里写下你的介绍：你是谁，这个站点用来做什么。]</p></div>
    <section class="anatomy" aria-labelledby="anatomy">
      <div class="anatomy-art" aria-hidden="true"><div><div></div></div></div>
      <div class="anatomy-list">
        <h2 id="anatomy" class="section-title">一只菠萝的构造</h2>
        <div><h3>果皮</h3><p>[别人第一眼注意到的你。]</p></div>
        <div><h3>果肉</h3><p>[你真正在乎并投入时间的事。]</p></div>
        <div><h3>果芯</h3><p>[无论怎样都不会变的你。]</p></div>
      </div>
    </section>
    <section class="home-section" aria-labelledby="past">
      <h2 id="past" class="section-title">做过的事</h2>
      <div class="work-grid">{work.map(() => <article><p class="mono">[年份]</p><h3>[项目或角色]</h3><p>[一句话简介。]</p></article>)}</div>
    </section>
    <section class="home-section" aria-labelledby="now">
      <h2 id="now" class="section-title">最近着迷于</h2>
      <div class="pills"><span>[话题]</span><span>[话题]</span><span>[话题]</span><span>[话题]</span></div>
    </section>
  </main>
</Base>
