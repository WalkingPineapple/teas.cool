---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { publicNotes } from '../lib/content';
// 全部公开笔记，最新在前，按年分组。周报永远不会出现在这里。
const notes = await publicNotes();
const yearOf = (n) => n.data.date.getUTCFullYear();
const years = [...new Set(notes.map(yearOf))];
const total = `共 ${notes.length} 篇`;
---
<Base title="归档" description="站点上的全部笔记，最新在前。">
  <main class="wrap">
    <div class="page-head"><h1>全部笔记，<em>最新在前</em></h1><p class="lede">{total}，涵盖写作、读书与旅行。</p></div>
    {years.map((year) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="section-title">{year}</h2>
        <EntryList notes={notes.filter((n) => yearOf(n) === year)} />
      </section>
    ))}
  </main>
</Base>
