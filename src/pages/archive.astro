---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import SearchBox from "../components/blog/SearchBox.astro";
import TagCloud from "../components/blog/TagCloud.astro";

const allPosts = await Astro.glob("./posts/*.md");
allPosts.sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());

const allTags = allPosts.flatMap(post => post.frontmatter.tags || []);

const postsByYear = allPosts.reduce((acc, post) => {
  const year = new Date(post.frontmatter.pubDate).getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="文章">
  <div class="archive-page">
    <div class="container">
      <header class="archive-header">
        <span class="eyebrow">Archive</span>
        <h1>文章目录</h1>
        <p>共 {allPosts.length} 篇文章，{new Set(allTags).size} 个标签。慢慢翻就好，不着急。</p>
      </header>

      <div class="archive-tools">
        <SearchBox placeholder="搜标题、内容或标签" />
        <TagCloud tags={allTags} />
      </div>

      <div class="year-list">
        {years.map(year => (
          <section class="year-group" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="year-heading">{year}</h2>
            <div class="post-list">
              {postsByYear[year].map(post => (
                <PostCard
                  title={post.frontmatter.title}
                  href={post.url}
                  description={post.frontmatter.description || post.compiledContent().replace(/<[^>]*>/g, '').slice(0, 120) + '...'}
                  date={post.frontmatter.pubDate}
                  tags={post.frontmatter.tags || []}
                  content={post.compiledContent()}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .archive-page {
    padding: var(--space-16) 0 0;
  }

  .archive-header {
    max-width: 42rem;
    margin-bottom: var(--space-10);
  }

  .archive-header h1 {
    margin: var(--space-3) 0 var(--space-4);
    color: var(--color-primary);
    font-size: var(--text-4xl);
  }

  .archive-header p {
    font-size: var(--text-lg);
  }

  .archive-tools {
    display: grid;
    grid-template-columns: minmax(18rem, 28rem) 1fr;
    align-items: start;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .year-group {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-16);
  }

  .year-heading {
    position: sticky;
    top: 6rem;
    align-self: start;
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-family-ui);
    font-size: var(--text-lg);
  }

  @media (max-width: 860px) {
    .archive-tools,
    .year-group {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .year-heading {
      position: static;
      padding-bottom: var(--space-2);
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
